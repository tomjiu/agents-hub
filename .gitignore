# Ignore secrets and junk
.env
**/.env
# Do not blanket-ignore names containing secret: skills are source assets.
**/node_modules/
**/__pycache__/
**/*.pyc
**/.git/
archive/
sources/
*.xpi
.bridge.log
**/mcp-auth.json
.asset-state/
**/operation.lock
**/.cache/
**/target/
# Build outputs except pinned Console vendor artifacts
**/dist/
!plugins/memory-net/console/vendor/memory-net/dist/
!plugins/memory-net/console/vendor/memory-net/dist/**
searchcore
searchcore.exe

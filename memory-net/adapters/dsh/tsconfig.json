{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmitOnError": true,
    "declaration": true,
    "sourceMap": false,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "../..",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "../../src/**/*.ts"]
}
